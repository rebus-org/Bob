<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>exe</OutputType>
	</PropertyGroup>

	<PropertyGroup>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>bob</ToolCommandName>
		<PackageId>Bob.The.Builder</PackageId>
		<Authors>Mogens Heller Grabe</Authors>
		<Company>Rebus FM</Company>
		<Description>Bob is a build tool that invokes scripts/build and scripts/release in the current repository, passing the project name and the latest version from CHANGELOG.md as arguments.</Description>
		<PackageTags>rebus;build;release;changelog;tool</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/rebus-org/Bob</RepositoryUrl>
		<PackageProjectUrl>https://github.com/rebus-org/Bob</PackageProjectUrl>
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts</PackageOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!--
		The SDK defaults the version to 1.0.0 (in its .targets, i.e. after this point), so we capture here whether
		a version was given explicitly (e.g. with -p:Version=1.2.3), and refuse to pack without one
	-->
	<PropertyGroup>
		<_ExplicitVersion>$(Version)$(VersionPrefix)</_ExplicitVersion>
	</PropertyGroup>

	<Target Name="EnsureVersionWhenPacking" BeforeTargets="GenerateNuspec">
		<Error Condition="'$(_ExplicitVersion)' == ''" Text="No version specified - please pack with a version, e.g. 'dotnet pack -p:Version=1.2.3' (or 'build.cmd 1.2.3')" />
	</Target>

	<ItemGroup>
		<Using Include="System" />
		<Using Include="System.Collections" />
		<Using Include="System.Collections.Concurrent" />
		<Using Include="System.Collections.Generic" />
		<Using Include="System.IO" />
		<Using Include="System.Linq" />
		<Using Include="System.Text" />
		<Using Include="System.Timers" />
		<Using Include="System.Diagnostics" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="semver" Version="3.0.0" />
		<PackageReference Include="spinnerino" Version="3.0.0" />
	</ItemGroup>

</Project>
